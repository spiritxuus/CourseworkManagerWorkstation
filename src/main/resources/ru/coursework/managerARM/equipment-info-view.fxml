                  <Insets bottom="12.0" />
               </VBox.margin>
            </Label>
            <Label text="Инвентарный номер: ">
               <VBox.margin>
                  <Insets bottom="12.0" />
               </VBox.margin>
            </Label>
            <Label text="Серийный номер: ">
