<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.coursework.managerARM.controller.NaturalClientInfoController">
   <children>
      <VBox prefHeight="200.0" prefWidth="100.0" AnchorPane.leftAnchor="1.0" AnchorPane.topAnchor="1.0">
         <children>
            <Label text="Имя:">
               <VBox.margin>
                  <Insets bottom="12.0" top="5.0" />
               </VBox.margin></Label>
            <Label text="Фамилия:">
               <VBox.margin>
                  <Insets bottom="13.0" />
               </VBox.margin></Label>
            <Label text="Отчество:">
               <VBox.margin>
                  <Insets bottom="13.0" />
               </VBox.margin></Label>
            <Label text="Дата рождения:">
               <VBox.margin>
                  <Insets bottom="13.0" />
               </VBox.margin></Label>
            <Label text="Пол:">
               <VBox.margin>
                  <Insets bottom="13.0" />
               </VBox.margin></Label>
            <Label text="Серия паспорта:">
               <VBox.margin>
                  <Insets bottom="13.0" />
               </VBox.margin></Label>
            <Label text="Номер паспорта:">
               <VBox.margin>
                  <Insets bottom="14.0" />
               </VBox.margin></Label>
            <Label text="Телефон:">
               <VBox.margin>
                  <Insets bottom="13.0" />
               </VBox.margin></Label>
            <Label text="Email">
               <VBox.margin>
                  <Insets bottom="14.0" />
               </VBox.margin></Label>
            <Label text="Адрес">
               <VBox.margin>
                  <Insets />
               </VBox.margin></Label>
         </children>
      </VBox>
      <VBox layoutX="10.0" layoutY="10.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="1.0">
         <children>
            <TextField fx:id="tfName" text="name">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="tfSurname" text="surname">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="tfPatronymic" text="patronymic">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="tfBirthdate" text="birthdate">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="tfGender" text="сделать комбобокс">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="tfPassportSeries" text="passport_series">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="ftfPassportNumber" text="passport_number">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="tfPhoneNumber" text="phone_number">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="ftEmail" text="email">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <ComboBox fx:id="cbAddress" prefWidth="150.0">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </ComboBox>
         </children>
      </VBox>
      <HBox AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="350.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onOkayButtonClick" text="Ок">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onAddAddrButton" text="Добавить адрес">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
