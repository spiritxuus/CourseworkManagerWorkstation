<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="200.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.coursework.managerARM.controller.LoginController">
   <children>
      <HBox spacing="33.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label text="%lb.login">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin></Label>
            <TextField fx:id="tfLogin">
               <HBox.margin>
                  <Insets />
               </HBox.margin></TextField>
         </children>
      </HBox>
      <HBox spacing="25.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="60.0">
         <children>
            <Label text="%lb.password">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin></Label>
            <PasswordField fx:id="tfPassword">
               <HBox.margin>
                  <Insets />
               </HBox.margin></PasswordField>
         </children>
      </HBox>
      <HBox spacing="40.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="100.0">
         <children>
            <Label text="%lb.language">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin></Label>
            <ComboBox fx:id="cbLanguage">
               <HBox.margin>
                  <Insets />
               </HBox.margin></ComboBox>
         </children>
      </HBox>
      <HBox spacing="10.0" AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onAuthenticateButtonClick" text="%button.ok" />
            <Button mnemonicParsing="false" onAction="#onCancelButtonClick" text="%button.exit" />
         </children>
      </HBox>
   </children>
</AnchorPane>
