<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.coursework.managerARM.controller.ReservationInfoController">
   <children>
      <VBox AnchorPane.leftAnchor="1.0" AnchorPane.topAnchor="1.0">
         <children>
            <Label text="Клиент:">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
            </Label>
            <Label text="Оборудование:">
               <VBox.margin>
                  <Insets bottom="8.0" />
               </VBox.margin>
            </Label>
            <Label text="Дата начала брони:">
               <VBox.margin>
                  <Insets bottom="13.0" />
               </VBox.margin>
            </Label>
            <Label text="Дата окончания брони:">
               <VBox.margin>
                  <Insets bottom="13.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
      <VBox layoutX="10.0" layoutY="10.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="1.0">
         <children>
            <Label fx:id="lbClient" text="1">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </Label>
            <Label fx:id="lbEquip" text="1">
               <VBox.margin>
                  <Insets top="7.0" />
               </VBox.margin>
            </Label>
            <DatePicker fx:id="dpStartDate">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </DatePicker>
            <DatePicker fx:id="dpEndDate">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </DatePicker>
         </children>
      </VBox>
      <HBox AnchorPane.leftAnchor="1.0" AnchorPane.topAnchor="200.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onOkayButtonClick" text="Ок" />
         </children>
      </HBox>
   </children>
</AnchorPane>
